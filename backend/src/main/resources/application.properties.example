# ===================================================================
# SmartPick Backend - Configuration Template
# Copy this file to 'application.properties' in this directory and
# configure with your local MySQL credentials before starting.
# ===================================================================

spring.application.name=smartpick-backend

# MySQL Database Configuration
# Replace 'your_mysql_username' and 'your_mysql_password' with your MySQL credentials
spring.datasource.url=jdbc:mysql://localhost:3306/smartpick?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# Server Configuration
server.port=8080
